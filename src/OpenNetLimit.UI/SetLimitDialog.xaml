<Window x:Class="OpenNetLimit.UI.SetLimitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:OpenNetLimit.UI.Services"
        Title="{loc:Loc SetLimit_Title}"
        Icon="Assets/OpenNetLimit.ico"
        Height="350" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="22,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Source="Assets/OpenNetLimit.png" Width="40" Height="40" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc SetLimit_Title}" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock Text="{loc:Loc SetLimit_Subtitle}" Style="{StaticResource SectionSubtitle}" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="22,18" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="118"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="{Binding ProcessLabel}"
                           FontWeight="SemiBold" FontSize="14" Margin="0,0,0,15"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc SetLimit_DownloadLabel}"
                           VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="DownloadBox" Text="0" Margin="0,0,8,8"
                         AutomationProperties.Name="{loc:Loc SetLimit_DownloadAutomation}"
                         TextChanged="OnInputChanged"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{loc:Loc RateUnit_Kbps}"
                           VerticalAlignment="Center" Margin="0,0,0,8" Foreground="{DynamicResource MutedTextBrush}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc SetLimit_UploadLabel}"
                           VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="UploadBox" Text="0" Margin="0,0,8,0"
                         AutomationProperties.Name="{loc:Loc SetLimit_UploadAutomation}"
                         TextChanged="OnInputChanged"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="{loc:Loc RateUnit_Kbps}"
                           VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/>

                <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,13,0,0">
                    <TextBlock Text="{loc:Loc SetLimit_ZeroHint}" Style="{StaticResource SectionSubtitle}"/>
                    <TextBlock x:Name="ErrorText" Text="{loc:Loc SetLimit_InvalidMessage}"
                               Foreground="{DynamicResource DangerBrush}" FontSize="11" Margin="0,5,0,0"
                               Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="22,13">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:Loc Action_Cancel}" Width="90" Margin="0,0,8,0" IsCancel="True"/>
                <Button Content="{loc:Loc Action_Ok}" Style="{StaticResource PrimaryButton}" Width="96"
                        IsDefault="True" Click="OnOk"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
