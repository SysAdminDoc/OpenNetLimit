<Window x:Class="OpenNetLimit.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:loc="clr-namespace:OpenNetLimit.UI.Services"
        Title="{loc:Loc Main_WindowTitle}"
        Icon="Assets/OpenNetLimit.ico"
        Height="760" Width="1120" MinHeight="680" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        KeyboardNavigation.TabNavigation="Cycle">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,17">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="Assets/OpenNetLimit.png"
                       Width="48" Height="48" Margin="0,0,14,0"
                       VerticalAlignment="Center"
                       AutomationProperties.Name="OpenNetLimit logo"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc Main_Title}" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="{loc:Loc Main_Subtitle}" Style="{StaticResource SectionSubtitle}" Margin="0,3,0,0"/>
                </StackPanel>

                <Border Grid.Column="2" Style="{StaticResource CardBorder}"
                        CornerRadius="8" Padding="13,9" MaxWidth="380"
                        ToolTip="{Binding StatusDetail}"
                        AutomationProperties.Name="{loc:Loc ServiceStatus_Automation}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Margin="0,0,9,0"
                                 Fill="{Binding StatusColor}" VerticalAlignment="Top"
                                 AutomationProperties.Name="{Binding StatusText}"/>
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Service_Label}" Style="{StaticResource EyebrowText}"/>
                            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold"
                                       AutomationProperties.LiveSetting="Polite"/>
                            <TextBlock Text="{Binding StatusDetail}" TextWrapping="Wrap" MaxWidth="330"
                                       Margin="0,3,0,0" FontSize="11.5"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       AutomationProperties.LiveSetting="Polite">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusDetail}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" x:Name="MainTabs" Margin="24,14,24,12"
                    SelectionChanged="OnTabChanged">
            <TabItem Header="{loc:Loc Tab_Realtime}">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="104"/>
                        <RowDefinition Height="216"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12"
                          AutomationProperties.Name="{loc:Loc TrafficSummary_Automation}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1.35*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="16,13">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource DownloadBrush}" CornerRadius="2" Margin="0,1,0,1"/>
                                <StackPanel Grid.Column="1" Margin="13,0,0,0">
                                    <TextBlock Text="{loc:Loc Metric_Download}" Style="{StaticResource EyebrowText}"/>
                                    <TextBlock Text="{Binding TotalDownload, Mode=OneWay}" FontSize="24" FontWeight="SemiBold"
                                               Foreground="{DynamicResource DownloadBrush}"
                                               AutomationProperties.Name="{Binding TotalDownload, StringFormat='Download speed: {0}'}"/>
                                    <TextBlock Text="{loc:Loc Metric_LiveTotal}" Style="{StaticResource SectionSubtitle}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="16,13">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource UploadBrush}" CornerRadius="2" Margin="0,1,0,1"/>
                                <StackPanel Grid.Column="1" Margin="13,0,0,0">
                                    <TextBlock Text="{loc:Loc Metric_Upload}" Style="{StaticResource EyebrowText}" Foreground="{DynamicResource UploadBrush}"/>
                                    <TextBlock Text="{Binding TotalUpload, Mode=OneWay}" FontSize="24" FontWeight="SemiBold"
                                               Foreground="{DynamicResource UploadBrush}"
                                               AutomationProperties.Name="{Binding TotalUpload, StringFormat='Upload speed: {0}'}"/>
                                    <TextBlock Text="{loc:Loc Metric_LiveTotal}" Style="{StaticResource SectionSubtitle}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="4" Style="{StaticResource CardBorder}" Padding="16,13">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Metric_Applications}" Style="{StaticResource EyebrowText}"/>
                                <TextBlock Text="{Binding ActiveConnectionCount}" FontSize="24" FontWeight="SemiBold"/>
                                <TextBlock Text="{loc:Loc Metric_ApplicationsHint}" Style="{StaticResource SectionSubtitle}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="6" Style="{StaticResource CardBorder}" Padding="16,11"
                                AutomationProperties.Name="{loc:Loc Metric_PcLimit}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{loc:Loc Metric_PcLimit}" Style="{StaticResource EyebrowText}"/>
                                <TextBlock Grid.Row="1" Text="{Binding PcLimitDisplay}" FontSize="19" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding PcLimitDisplay}"
                                           AutomationProperties.LiveSetting="Polite"/>
                                <Grid Grid.Row="2" Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding PcLimitHint}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding PcLimitHint}"
                                               AutomationProperties.LiveSetting="Polite">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource SectionSubtitle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PcLimitHintIsError}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Grid.Column="1" Content="{loc:Loc PcLimit_Change}" Style="{StaticResource CompactButton}"
                                            Margin="8,0,0,0" Click="OnSetPcLimit" IsEnabled="{Binding CanEditPcLimit}"
                                            ToolTipService.ShowOnDisabled="True" ToolTip="{Binding PcLimitButtonHint}"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="16,12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Chart_LiveTitle}" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="{loc:Loc Chart_LiveSubtitle}" Style="{StaticResource SectionSubtitle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="14" Height="3" CornerRadius="2" Background="{DynamicResource DownloadBrush}"/>
                                    <TextBlock Text="{loc:Loc Chart_Download}" Margin="6,0,14,0"
                                               Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/>
                                    <Border Width="14" Height="3" CornerRadius="2" Background="{DynamicResource UploadBrush}"/>
                                    <TextBlock Text="{loc:Loc Chart_Upload}" Margin="6,0,18,0"
                                               Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/>
                                    <TextBlock Text="{loc:Loc Chart_WindowLabel}" Style="{StaticResource EyebrowText}"/>
                                </StackPanel>
                            </Grid>
                            <lvc:CartesianChart Grid.Row="1"
                                                Background="{DynamicResource PanelBackgroundBrush}"
                                                Series="{Binding ChartSeries}"
                                                YAxes="{Binding ChartYAxes}"
                                                XAxes="{Binding ChartXAxes}"
                                                AnimationsSpeed="00:00:00.200"
                                                AutomationProperties.Name="{loc:Loc Chart_Automation}"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="16,12,16,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc ProcessList_Title}" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="{loc:Loc ProcessList_Hint}" Style="{StaticResource SectionSubtitle}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding ActiveRulesDisplay}" Style="{StaticResource EyebrowText}"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <DataGrid Grid.Row="1" x:Name="ProcessGrid" ItemsSource="{Binding Processes}"
                                      SelectedItem="{Binding SelectedProcess, Mode=TwoWay}"
                                      loc:DataGridRightClick.SelectRowOnRightClick="True"
                                      Style="{StaticResource DataGridStyle}"
                                      AutomationProperties.Name="{loc:Loc ProcessGrid_Automation}">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{loc:Loc Menu_SetBandwidthLimit}" Click="OnSetLimit" IsEnabled="{Binding CanEditLimits}"
                                                  ToolTipService.ShowOnDisabled="True"
                                                  ToolTip="{Binding LimitMenuHint}"/>
                                        <MenuItem Header="{loc:Loc Menu_RemoveLimit}" Click="OnRemoveLimit" IsEnabled="{Binding CanEditLimits}"
                                                  ToolTipService.ShowOnDisabled="True"
                                                  ToolTip="{Binding LimitMenuHint}"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Loc Column_Process}" Binding="{Binding DisplayName}" Width="1.55*"/>
                                    <DataGridTextColumn Header="{loc:Loc Column_PID}" Binding="{Binding ProcessId}" Width="0.55*"/>
                                    <DataGridTextColumn Header="{loc:Loc Column_DownloadPerSecond}" Binding="{Binding DownloadDisplay}" Width="*"/>
                                    <DataGridTextColumn Header="{loc:Loc Column_UploadPerSecond}" Binding="{Binding UploadDisplay}" Width="*"/>
                                    <DataGridTextColumn Header="{loc:Loc Column_TotalDown}" Binding="{Binding TotalDownDisplay}" Width="*"/>
                                    <DataGridTextColumn Header="{loc:Loc Column_TotalUp}" Binding="{Binding TotalUpDisplay}" Width="*"/>
                                    <DataGridTextColumn Header="{loc:Loc Column_Limit}" Binding="{Binding LimitDisplay}" Width="1.35*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="{loc:Loc Tab_Rules}" x:Name="RulesTab">
                <Grid Margin="0,12,0,0" DataContext="{Binding RulesViewModel}">
                    <Grid.Resources>
                        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="MinWidth" Value="74"/>
                            <Setter Property="Margin" Value="0,0,8,0"/>
                            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                        </Style>
                        <Style x:Key="EmptyListText" TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="TextAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="24,38,24,0"/>
                            <Setter Property="IsHitTestVisible" Value="False"/>
                        </Style>
                        <!-- A long path or schedule ends in "..." and shows in full on hover. -->
                        <Style x:Key="TrimmedCell" TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            <Style.Triggers>
                                <!-- An empty cell (no name, no group) shows no empty tooltip box. -->
                                <Trigger Property="Text" Value="">
                                    <Setter Property="ToolTip" Value="{x:Null}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Resources>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="200"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="16,12,8,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{loc:Loc Rules_Title}" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="{loc:Loc Rules_Subtitle}" Style="{StaticResource SectionSubtitle}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{loc:Loc Rules_Add}" Style="{StaticResource PrimaryButton}" Click="OnAddRule"
                                            MinWidth="96" Margin="0,0,8,0" ToolTipService.ShowOnDisabled="True"
                                            IsEnabled="{Binding CanEdit}" ToolTip="{Binding EditHint}"/>
                                    <Button Content="{loc:Loc Rules_Edit}" Style="{StaticResource ToolbarButton}" Click="OnEditRule"
                                            IsEnabled="{Binding CanChangeSelectedRule}" ToolTip="{Binding EditHint}"/>
                                    <Button Content="{Binding ToggleLabel}" Style="{StaticResource ToolbarButton}" Click="OnToggleRule"
                                            IsEnabled="{Binding CanChangeSelectedRule}" ToolTip="{Binding EditHint}"/>
                                    <Button Content="{loc:Loc Rules_Delete}" Style="{StaticResource ToolbarButton}" Click="OnDeleteRule"
                                            IsEnabled="{Binding CanChangeSelectedRule}" ToolTip="{Binding EditHint}"/>
                                    <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="4,6,12,6"/>
                                    <Button Content="{loc:Loc Rules_Import}" Style="{StaticResource ToolbarButton}" Click="OnImportRules"
                                            IsEnabled="{Binding CanEdit}" ToolTip="{Binding EditHint}"/>
                                    <Button Content="{loc:Loc Rules_Export}" Style="{StaticResource ToolbarButton}" Click="OnExportRules"/>
                                    <Button Content="{loc:Loc Rules_Refresh}" Style="{StaticResource ToolbarButton}" Click="OnRefreshRules"/>
                                </StackPanel>
                            </Grid>

                            <DataGrid Grid.Row="1" x:Name="RulesGrid" ItemsSource="{Binding Rules}"
                                      SelectedItem="{Binding SelectedRule, Mode=TwoWay}"
                                      loc:DataGridRightClick.SelectRowOnRightClick="True"
                                      MouseDoubleClick="OnRuleDoubleClick"
                                      Style="{StaticResource DataGridStyle}"
                                      AutomationProperties.Name="{loc:Loc Rules_GridAutomation}">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{loc:Loc Rules_Edit}" Click="OnEditRule"
                                                  IsEnabled="{Binding CanChangeSelectedRule}"
                                                  ToolTipService.ShowOnDisabled="True" ToolTip="{Binding EditHint}"/>
                                        <MenuItem Header="{Binding ToggleLabel}" Click="OnToggleRule"
                                                  IsEnabled="{Binding CanChangeSelectedRule}"
                                                  ToolTipService.ShowOnDisabled="True" ToolTip="{Binding EditHint}"/>
                                        <MenuItem Header="{loc:Loc Rules_Delete}" Click="OnDeleteRule"
                                                  IsEnabled="{Binding CanChangeSelectedRule}"
                                                  ToolTipService.ShowOnDisabled="True" ToolTip="{Binding EditHint}"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Loc Column_Program}" Binding="{Binding Target}" Width="1.5*" ElementStyle="{StaticResource TrimmedCell}"/>
                                    <DataGridTextColumn Header="{loc:Loc Column_Name}" Binding="{Binding Name}" Width="1.1*" ElementStyle="{StaticResource TrimmedCell}"/>
                                    <DataGridTextColumn Header="{loc:Loc Column_Action}" Binding="{Binding ActionDisplay}" Width="0.7*"/>
                                    <DataGridTextColumn Header="{loc:Loc Column_Limit}" Binding="{Binding LimitDisplay}" Width="1.3*" ElementStyle="{StaticResource TrimmedCell}"/>
                                    <DataGridTextColumn Header="{loc:Loc Column_Schedule}" Binding="{Binding ScheduleDisplay}" Width="1.3*" ElementStyle="{StaticResource TrimmedCell}"/>
                                    <DataGridTextColumn Header="{loc:Loc Column_Group}" Binding="{Binding GroupDisplay}" Width="0.8*" ElementStyle="{StaticResource TrimmedCell}"/>
                                    <DataGridTextColumn Header="{loc:Loc Column_Quota}" Binding="{Binding QuotaDisplay}" Width="1.3*" ElementStyle="{StaticResource TrimmedCell}"/>
                                    <DataGridTextColumn Header="{loc:Loc Column_State}" Binding="{Binding StateDisplay}" Width="Auto" MinWidth="70"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Grid.Row="1" Text="{loc:Loc Rules_Empty}" Style="{StaticResource EmptyListText}"
                                       Visibility="{Binding HasNoRules, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Grid.Row="1" Text="{Binding ChangesRefused}" Style="{StaticResource EmptyListText}"
                                       Visibility="{Binding ShowsRulesRefused, Converter={StaticResource BoolToVisibility}}"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" MinHeight="40" Margin="4,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Message}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="900"
                                       AutomationProperties.LiveSetting="Polite">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Content="{loc:Loc Rules_Undo}" Style="{StaticResource CompactButton}" Click="OnUndoRules"
                                    Margin="12,0,0,0" Visibility="{Binding CanUndo, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="16,12,8,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{loc:Loc Alerts_Title}" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="{loc:Loc Alerts_Subtitle}" Style="{StaticResource SectionSubtitle}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{loc:Loc Alerts_Add}" Style="{StaticResource ToolbarButton}" Click="OnAddAlert"
                                            MinWidth="96" IsEnabled="{Binding CanEdit}" ToolTip="{Binding EditHint}"/>
                                    <Button Content="{loc:Loc Rules_Edit}" Style="{StaticResource ToolbarButton}" Click="OnEditAlert"
                                            IsEnabled="{Binding CanChangeSelectedAlert}" ToolTip="{Binding EditHint}"/>
                                    <Button Content="{loc:Loc Rules_Delete}" Style="{StaticResource ToolbarButton}" Click="OnDeleteAlert"
                                            IsEnabled="{Binding CanChangeSelectedAlert}" ToolTip="{Binding EditHint}"/>
                                </StackPanel>
                            </Grid>

                            <DataGrid Grid.Row="1" x:Name="AlertsGrid" ItemsSource="{Binding Alerts}"
                                      SelectedItem="{Binding SelectedAlert, Mode=TwoWay}"
                                      loc:DataGridRightClick.SelectRowOnRightClick="True"
                                      MouseDoubleClick="OnAlertDoubleClick"
                                      Style="{StaticResource DataGridStyle}"
                                      AutomationProperties.Name="{loc:Loc Alerts_GridAutomation}">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{loc:Loc Rules_Edit}" Click="OnEditAlert"
                                                  IsEnabled="{Binding CanChangeSelectedAlert}"
                                                  ToolTipService.ShowOnDisabled="True" ToolTip="{Binding EditHint}"/>
                                        <MenuItem Header="{loc:Loc Rules_Delete}" Click="OnDeleteAlert"
                                                  IsEnabled="{Binding CanChangeSelectedAlert}"
                                                  ToolTipService.ShowOnDisabled="True" ToolTip="{Binding EditHint}"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Loc Column_Name}" Binding="{Binding Name}" Width="1.2*" ElementStyle="{StaticResource TrimmedCell}"/>
                                    <DataGridTextColumn Header="{loc:Loc Column_Program}" Binding="{Binding Target}" Width="1.5*" ElementStyle="{StaticResource TrimmedCell}"/>
                                    <DataGridTextColumn Header="{loc:Loc Column_Direction}" Binding="{Binding DirectionDisplay}" Width="1*"/>
                                    <DataGridTextColumn Header="{loc:Loc Column_Threshold}" Binding="{Binding ThresholdDisplay}" Width="0.9*"/>
                                    <DataGridTextColumn Header="{loc:Loc Column_Cooldown}" Binding="{Binding CooldownDisplay}" Width="0.9*"/>
                                    <DataGridTextColumn Header="{loc:Loc Column_State}" Binding="{Binding StateDisplay}" Width="Auto" MinWidth="70"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Grid.Row="1" Text="{loc:Loc Alerts_Empty}" Style="{StaticResource EmptyListText}"
                                       Visibility="{Binding HasNoAlerts, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Grid.Row="1" Text="{Binding ChangesRefused}" Style="{StaticResource EmptyListText}"
                                       Visibility="{Binding ShowsAlertsRefused, Converter={StaticResource BoolToVisibility}}"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="{loc:Loc Tab_History}" x:Name="HistoryTab">
                <Grid Margin="0,12,0,0" DataContext="{Binding HistoryViewModel}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="16,12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{loc:Loc History_Title}" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="{loc:Loc History_Subtitle}" Style="{StaticResource SectionSubtitle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ComboBox ItemsSource="{Binding ProcessNames}" SelectedItem="{Binding SelectedProcess}"
                                          MinWidth="190" Margin="0,0,14,0"/>
                                <RadioButton Content="{loc:Loc History_Hourly}" IsChecked="{Binding IsHourly}"
                                             Margin="0,0,14,0" GroupName="HistoryGranularity"/>
                                <RadioButton Content="{loc:Loc History_Daily}" IsChecked="{Binding IsDaily}"
                                             Margin="0,0,14,0" GroupName="HistoryGranularity"/>
                                <Button Content="{loc:Loc History_Refresh}" Click="OnHistoryRefresh" MinWidth="86"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,4">
                                <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource DownloadBrush}"/>
                                <TextBlock Text="{loc:Loc History_Received}" Margin="7,0,16,0"
                                           Foreground="{DynamicResource MutedTextBrush}"/>
                                <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource UploadBrush}"/>
                                <TextBlock Text="{loc:Loc History_Sent}" Margin="7,0,0,0"
                                           Foreground="{DynamicResource MutedTextBrush}"/>
                            </StackPanel>
                            <lvc:CartesianChart Grid.Row="1" Background="{DynamicResource PanelBackgroundBrush}"
                                                Series="{Binding HistorySeries}"
                                                YAxes="{Binding HistoryYAxes}"
                                                XAxes="{Binding HistoryXAxes}"
                                                AnimationsSpeed="00:00:00.300"
                                                AutomationProperties.Name="{loc:Loc History_Automation}"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="{DynamicResource StatusBarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="16,7" AutomationProperties.Name="{loc:Loc StatusBar_Automation}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ConnectionsDisplay}" Foreground="{DynamicResource MutedTextBrush}"/>
                    <Border Width="1" Height="14" Background="{DynamicResource BorderBrush}" Margin="12,0"/>
                    <TextBlock Text="{Binding ActiveRulesDisplay}" Foreground="{DynamicResource MutedTextBrush}"/>
                    <Border Width="1" Height="14" Background="{DynamicResource BorderBrush}" Margin="12,0"/>
                    <TextBlock Text="{Binding RecentAlertsDisplay}" Foreground="{DynamicResource MutedTextBrush}"/>
                    <Border Width="1" Height="14" Background="{DynamicResource BorderBrush}" Margin="12,0"/>
                    <TextBlock Text="{Binding PermissionModeDisplay}" Foreground="{DynamicResource MutedTextBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="{Binding UpdateAvailableDisplay}" Style="{StaticResource CompactButton}"
                            Margin="0,0,8,0" Click="OnOpenReleasePage"
                            Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="{loc:Loc Update_Available_Tooltip}"
                            AutomationProperties.Name="{Binding UpdateAvailableDisplay}"/>
                    <Button Content="{Binding UpdatesDisplay}" Style="{StaticResource CompactButton}" MinWidth="98"
                            Margin="0,0,8,0" Click="OnToggleUpdates"
                            Visibility="{Binding CanToggleUpdates, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="{loc:Loc Updates_Tooltip}"
                            AutomationProperties.Name="{Binding UpdatesDisplay}"/>
                    <Button Content="{Binding ThemeDisplay}" Style="{StaticResource CompactButton}" MinWidth="98"
                            Click="OnToggleTheme" AutomationProperties.Name="{Binding ThemeDisplay, StringFormat='Current {0}'}"/>
                    <Button Content="{Binding LanguageDisplay}" Style="{StaticResource CompactButton}" MinWidth="106"
                            Margin="8,0,0,0" Click="OnToggleLanguage" AutomationProperties.Name="{Binding LanguageDisplay}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
