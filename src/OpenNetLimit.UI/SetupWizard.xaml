<Window x:Class="OpenNetLimit.UI.SetupWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:OpenNetLimit.UI.Services"
        Title="{loc:Loc Setup_Title}"
        Icon="Assets/OpenNetLimit.ico"
        Height="500" Width="720"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0A1424" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <Image Source="Assets/OpenNetLimit.png" Width="56" Height="56" HorizontalAlignment="Left"/>
                    <TextBlock Text="OpenNetLimit" FontSize="20" FontWeight="Bold" Margin="0,12,0,0"/>
                    <TextBlock Text="{loc:Loc Main_Subtitle}" Style="{StaticResource SectionSubtitle}"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <Border x:Name="StepOne" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="01" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Width="28"/>
                            <TextBlock Text="{loc:Loc Setup_StepWelcome}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="StepTwo" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="02" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Width="28"/>
                            <TextBlock Text="{loc:Loc Setup_StepRequirements}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="StepThree" CornerRadius="6" Padding="12,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="03" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Width="28"/>
                            <TextBlock Text="{loc:Loc Setup_StepReady}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="{loc:Loc Setup_LocalNote}" Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="11" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TabControl x:Name="Pages" Grid.Row="0" Margin="34,28,34,12"
                        BorderThickness="0" TabStripPlacement="Left" Background="Transparent">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </TabControl.ItemContainerStyle>

                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="StepLabel" Text="{loc:Loc Setup_StepOneOfThree}" Style="{StaticResource EyebrowText}"/>
                            <TextBlock Text="{loc:Loc Setup_WelcomeTitle}" FontSize="28" FontWeight="Bold" Margin="0,10,0,10"/>
                            <TextBlock Text="{loc:Loc Setup_WelcomeBody}" TextWrapping="Wrap" FontSize="14" LineHeight="22"/>
                        </StackPanel>
                        <Border Grid.Row="1" Style="{StaticResource CardBorder}" VerticalAlignment="Center" Padding="18">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Setup_WelcomeCardTitle}" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="{loc:Loc Setup_WelcomeHint}" TextWrapping="Wrap"
                                           Style="{StaticResource SectionSubtitle}" Margin="0,6,0,0" LineHeight="18"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem>
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Setup_StepTwoOfThree}" Style="{StaticResource EyebrowText}"/>
                        <TextBlock Text="{loc:Loc Setup_RequirementsTitle}" FontSize="26" FontWeight="Bold" Margin="0,10,0,18"/>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Setup_RequirementsPrivileges}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                <TextBlock Text="{loc:Loc Setup_RequirementsService}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Setup_RequirementsAntivirus}" TextWrapping="Wrap"/>
                                <TextBlock Text="{loc:Loc Setup_RequirementsStorage}" TextWrapping="Wrap"
                                           Style="{StaticResource SectionSubtitle}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>

                <TabItem>
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Setup_StepThreeOfThree}" Style="{StaticResource EyebrowText}"/>
                        <TextBlock Text="{loc:Loc Setup_ReadyTitle}" FontSize="26" FontWeight="Bold" Margin="0,10,0,18"/>
                        <Border Style="{StaticResource CardBorder}" Padding="18">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Setup_ReadyBodyPrimary}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                <TextBlock Text="{loc:Loc Setup_ReadyBodySecondary}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                <TextBlock Text="{loc:Loc Setup_ReadyHint}" TextWrapping="Wrap"
                                           Style="{StaticResource SectionSubtitle}" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>
            </TabControl>

            <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="{loc:Loc Action_Skip}" Style="{StaticResource QuietButton}" Width="82" Click="OnSkip"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="BtnBack" Content="{loc:Loc Action_Back}" Width="88" Margin="0,0,8,0"
                                Click="OnBack" IsEnabled="False"/>
                        <Button x:Name="BtnNext" Content="{loc:Loc Action_Next}" Style="{StaticResource PrimaryButton}"
                                Width="96" Click="OnNext" IsDefault="True"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
