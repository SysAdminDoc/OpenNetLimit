<Window x:Class="OpenNetLimit.UI.RuleEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:OpenNetLimit.UI.Services"
        Icon="Assets/OpenNetLimit.ico"
        Width="660" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="22,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Source="Assets/OpenNetLimit.png" Width="40" Height="40" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderTitle" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock Text="{loc:Loc RuleEditor_Subtitle}" Style="{StaticResource SectionSubtitle}" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Scrolls only on a screen too short for the whole form. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource CardBorder}" Margin="22,18" Padding="18">
                <Grid>
                    <Grid.Resources>
                        <Style x:Key="FieldLabel" TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="0,0,0,8"/>
                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                        </Style>
                        <Style x:Key="InlineText" TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                        </Style>
                        <Style x:Key="FieldHint" TargetType="TextBlock" BasedOn="{StaticResource SectionSubtitle}">
                            <Setter Property="Margin" Value="0,-3,0,12"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </Grid.Resources>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Text="{loc:Loc RuleEditor_ProgramLabel}" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ProgramBox" Margin="0,0,0,8"
                             AutomationProperties.Name="{loc:Loc RuleEditor_ProgramLabel}"/>

                    <TextBlock Grid.Row="1" Text="{loc:Loc RuleEditor_PathLabel}" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="PathBox" Margin="0,0,8,8"
                             AutomationProperties.Name="{loc:Loc RuleEditor_PathLabel}"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="{loc:Loc RuleEditor_Browse}" Margin="0,0,0,8"
                            MinWidth="86" Click="OnBrowse"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{loc:Loc RuleEditor_ProgramHint}"
                               Style="{StaticResource FieldHint}"/>

                    <TextBlock Grid.Row="3" Text="{loc:Loc RuleEditor_NameLabel}" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" x:Name="NameBox" Margin="0,0,0,8"
                             AutomationProperties.Name="{loc:Loc RuleEditor_NameLabel}"/>

                    <TextBlock Grid.Row="4" Text="{loc:Loc RuleEditor_ActionLabel}" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Grid.Row="4" Grid.Column="1" x:Name="ActionCombo" Margin="0,0,8,8" MinWidth="180"
                              HorizontalAlignment="Left" SelectionChanged="OnChoiceChanged"
                              AutomationProperties.Name="{loc:Loc RuleEditor_ActionLabel}"/>

                    <TextBlock Grid.Row="5" Text="{loc:Loc RuleEditor_SpeedLabel}" Style="{StaticResource FieldLabel}"/>
                    <StackPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{loc:Loc RuleEditor_DownloadLabel}" Style="{StaticResource InlineText}" Margin="0,0,8,0"/>
                        <TextBox x:Name="DownloadBox" Width="90"
                                 AutomationProperties.Name="{loc:Loc RuleEditor_DownloadLabel}"/>
                        <TextBlock Text="{loc:Loc RateUnit_Kbps}" Style="{StaticResource InlineText}" Margin="6,0,22,0"/>
                        <TextBlock Text="{loc:Loc RuleEditor_UploadLabel}" Style="{StaticResource InlineText}" Margin="0,0,8,0"/>
                        <TextBox x:Name="UploadBox" Width="90"
                                 AutomationProperties.Name="{loc:Loc RuleEditor_UploadLabel}"/>
                        <TextBlock Text="{loc:Loc RateUnit_Kbps}" Style="{StaticResource InlineText}" Margin="6,0,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Text="{loc:Loc RuleEditor_ZeroHint}"
                               Style="{StaticResource FieldHint}"/>

                    <TextBlock Grid.Row="7" Text="{loc:Loc RuleEditor_HoursLabel}" Style="{StaticResource FieldLabel}"/>
                    <StackPanel Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox x:Name="StartBox" Width="80"
                                 AutomationProperties.Name="{loc:Loc RuleEditor_HoursLabel}"/>
                        <TextBlock Text="{loc:Loc RuleEditor_To}" Style="{StaticResource InlineText}" Margin="10,0"/>
                        <TextBox x:Name="EndBox" Width="80"
                                 AutomationProperties.Name="{loc:Loc RuleEditor_To}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="8" Text="{loc:Loc RuleEditor_DaysLabel}" Style="{StaticResource FieldLabel}"/>
                    <WrapPanel Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" x:Name="DaysPanel" Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2" Text="{loc:Loc RuleEditor_ScheduleHint}"
                               Style="{StaticResource FieldHint}"/>

                    <TextBlock Grid.Row="10" Text="{loc:Loc RuleEditor_GroupLabel}" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="10" Grid.Column="1" x:Name="GroupBox" Margin="0,0,16,8"
                             AutomationProperties.Name="{loc:Loc RuleEditor_GroupLabel}"/>
                    <CheckBox Grid.Row="10" Grid.Column="2" x:Name="EnabledCheck" Margin="0,0,0,8"
                              VerticalAlignment="Center" Content="{loc:Loc RuleEditor_Enabled}"/>

                    <Border Grid.Row="11" Grid.ColumnSpan="3" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0" Margin="0,4,0,0"/>
                    <CheckBox Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="3" x:Name="QuotaCheck" Margin="0,16,0,10"
                              Content="{loc:Loc RuleEditor_QuotaCheck}" FontWeight="SemiBold"
                              Checked="OnChoiceChanged" Unchecked="OnChoiceChanged"/>

                    <TextBlock Grid.Row="12" Text="{loc:Loc RuleEditor_QuotaLabel}" Style="{StaticResource FieldLabel}"/>
                    <StackPanel Grid.Row="12" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox x:Name="QuotaBox" Width="110"
                                 AutomationProperties.Name="{loc:Loc RuleEditor_QuotaLabel}"/>
                        <TextBlock Text="{loc:Loc RateUnit_MB}" Style="{StaticResource InlineText}" Margin="8,0,12,0"/>
                        <ComboBox x:Name="PeriodCombo" MinWidth="140"
                                  AutomationProperties.Name="{loc:Loc RuleEditor_QuotaLabel}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="13" Text="{loc:Loc RuleEditor_WhenUsedUp}" Style="{StaticResource FieldLabel}"
                               TextWrapping="Wrap"/>
                    <StackPanel Grid.Row="13" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
                        <ComboBox x:Name="QuotaActionCombo" MinWidth="180" SelectionChanged="OnChoiceChanged"
                                  AutomationProperties.Name="{loc:Loc RuleEditor_WhenUsedUp}"/>
                        <!-- Only a slowdown needs a speed: "Slow it down to 10 KB/s". -->
                        <StackPanel x:Name="ThrottlePanel" Orientation="Horizontal">
                            <TextBlock Text="{loc:Loc RuleEditor_To}" Style="{StaticResource InlineText}" Margin="10,0"/>
                            <TextBox x:Name="ThrottleBox" Width="90"
                                     AutomationProperties.Name="{loc:Loc RuleEditor_SlowTo}"/>
                            <TextBlock Text="{loc:Loc RateUnit_Kbps}" Style="{StaticResource InlineText}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </ScrollViewer>

        <!-- The error sits by the buttons so it shows however far the form is scrolled. -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="22,13">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"
                           Foreground="{DynamicResource DangerBrush}"
                           Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{loc:Loc Action_Cancel}" Width="90" Margin="0,0,8,0" IsCancel="True"/>
                    <Button x:Name="SaveButton" Content="{loc:Loc Action_Save}" Style="{StaticResource PrimaryButton}"
                            Width="96" IsDefault="True" Click="OnSave"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
